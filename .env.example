# .env.example – Holt-Eco Platform

# Node environment
NODE_ENV=development

# JWT secret for signing tokens — change this before production
JWT_SECRET=<your-super-secret>

# Postgres database connection string
DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/<database>

# Redis instance URL
REDIS_URL=redis://<host>:<port>

# Application port for gateway (optional if default is fine)
PORT=3000

# Additional environment variables for future services
# AUTH_PORT=3001
# RECON_SERVICE_URL=http://localhost:3006
# BOUNTY_SERVICE_URL=http://localhost:3002

# Logging / monitoring
# LOG_LEVEL=info
